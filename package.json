{
  "name": "prompt-to-paint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Measures how long an agent takes to render something a human can react to, and where that time actually goes.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "p2p": "./bin/p2p.js"
  },
  "scripts": {
    "p2p": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:e2e": "node --test --test-timeout=600000 test/e2e/*.test.ts",
    "test:all": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.56",
    "@ai-sdk/google": "^4.0.74",
    "@ai-sdk/openai": "^4.0.69",
    "ai": "^7.0.105",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2"
  }
}
